# Business contact email, shown across the site (public)
NEXT_PUBLIC_EMAIL=

# Business phone, 10-digit US number in any format (public). Shown as "(602) 555 - 0100" on the site.
NEXT_PUBLIC_PHONE=

# Zelle payment details shown at checkout (public): the email registered with Zelle, and the recipient name the bank shows for it
NEXT_PUBLIC_ZELLE_EMAIL=
NEXT_PUBLIC_ZELLE_RECIPIENT=

# Formspree form endpoints (server only; never prefix with NEXT_PUBLIC_), e.g. https://formspree.io/f/abcdwxyz
FORMSPREE_PRIVATE_QUOTE_ENDPOINT=
FORMSPREE_PRIVATE_ORDER_ENDPOINT=
